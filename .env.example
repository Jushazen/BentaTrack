# Copy this file to .env and fill in real values. Never commit .env.

# --- Local PostgreSQL (docker compose reads these) ---
POSTGRES_USER=bentatrack
POSTGRES_PASSWORD=change-me
POSTGRES_DB=bentatrack
POSTGRES_PORT=5433

# Prisma connection string. Must match the values above for local dev.
# Production: the Neon connection string from the Vercel dashboard.
DATABASE_URL=postgresql://bentatrack:change-me@localhost:5433/bentatrack

# Integration tests use a separate database on the same server (created by the tests).
TEST_DATABASE_URL=postgresql://bentatrack:change-me@localhost:5433/bentatrack_test

# --- NextAuth.js v4 ---
# Any random string of 32+ bytes, e.g. from: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
NEXTAUTH_SECRET=replace-with-a-random-secret
# Base URL of the app. Local: http://localhost:3000. On Vercel this can be left unset.
NEXTAUTH_URL=http://localhost:3000

# --- Vercel Blob (product images) ---
# From Vercel dashboard > Storage > Blob. Leave empty for local dev until the images leaf.
BLOB_READ_WRITE_TOKEN=

# --- First owner account created by `npm run db:seed` (logs in by email) ---
SEED_OWNER_EMAIL=owner@estetika.local
SEED_OWNER_PASSWORD=change-me-too
